\mode<presentation>{\lecture[Erfahrung in der Lehre]{Erfahrung in der Lehre}{Erfahrung in der Lehre}}

\part{Einsatzmöglichkeiten}
\begin{frame}{Einsatzmöglichkeiten}{Erfahrung in der Lehre}
  \begin{itemize}
    \item Einblick in multiplexed I/O und event-driven Softwaredesign nehmen
    \begin{itemize}
      \item I/O multiplexer
      \item Event queue, event dispatching, event receiving
      \item Timer
    \end{itemize}
    \item Kenntnisse über Socket API in verschiedenen Netzwerkprotokollen erlangen, speziell
    \begin{itemize}
      \item IPv6, Dual/Single-Stack, IPv6 mapped addresses, \ldots
      \item Bluetooth l2cap und rfcomm
    \end{itemize}
    \item Experimente mit sicheren Verbindungen (SSL/TLS) durchführen
    \begin{itemize}
      \item Z.B. eigene Certifikate Authority aufbauen
    \end{itemize}
    \item SAX-artiges Stream-Parser Design studieren
    \begin{itemize}
      \item HTTP Parser
      \item WebSocket Parser
      \item MQTT Parser
    \end{itemize}
    \item Experimente und HTTP
    \item Experimente mit WebSockets
    \item MQTT Konzepte und Implementierungsmöglichkeiten kennen lernen
    \item Einsatz von MQTTBroker und MQTTIntegrator in IoT Kursen
  \end{itemize}
\end{frame}
